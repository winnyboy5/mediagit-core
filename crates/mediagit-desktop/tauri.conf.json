{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaGit",
  "identifier": "dev.mediagit.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      {
        "title": "MediaGit",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$TEMP/mediagit-desktop-preview/**"] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
