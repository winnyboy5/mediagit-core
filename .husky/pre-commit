#!/bin/sh
# Pre-commit hook: runs formatting, linting, and checks in sequence

echo "🔍 Running pre-commit checks..."

# 1. Check formatting
echo "  → cargo fmt --check"
cargo fmt --check
if [ $? -ne 0 ]; then
  echo "❌ Formatting check failed. Run 'cargo fmt' to fix."
  exit 1
fi

# 2. Run clippy
echo "  → cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings
if [ $? -ne 0 ]; then
  echo "❌ Clippy check failed. Fix the warnings above."
  exit 1
fi

# 3. License header check
missing=0
for file in $(git diff --cached --name-only --diff-filter=ACM -- '*.rs'); do
  if ! grep -q "SPDX-License-Identifier: BUSL-1.1" "$file" 2>/dev/null; then
    echo "❌ Missing license header: $file"
    missing=$((missing + 1))
  fi
done
if [ "$missing" -gt 0 ]; then
  echo "❌ $missing file(s) missing BUSL-1.1 license headers"
  exit 1
fi

# 4. Large file check (> 5MB)
MAX_SIZE=$((5 * 1024 * 1024))
large_files=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
    if [ "$size" -gt "$MAX_SIZE" ] 2>/dev/null; then
      echo "❌ Large file: $file (exceeds 5MB limit)"
      large_files=$((large_files + 1))
    fi
  fi
done
if [ "$large_files" -gt 0 ]; then
  echo "❌ $large_files file(s) exceed 5MB."
  exit 1
fi

# 5. Conflict marker check
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  if grep -qE "^(<<<<<<<|=======|>>>>>>>)" "$file" 2>/dev/null; then
    echo "❌ Conflict markers found in: $file"
    exit 1
  fi
done

# 6. Secret check on staged ADDITIONS only.
#
# There is no secret scanner anywhere else -- not in this hook, not in CI --
# and this repo has already run one leaked-secret remediation sprint
# (2026-07-18, see .gitignore's `enc_key` entry). The real credentials live
# under dev-tests/dev-server/ and dev-tests/qa-suite/work/, both gitignored,
# and the tracked backend configs hold only {{TOKEN}} placeholders; this is
# the backstop for when that arrangement is broken by accident.
#
# The pattern set was tuned against the whole tracked corpus and matches zero
# lines of it today, so it can be enforced without grandfathering anything.
# The allowlist exists because the docs legitimately quote AWS's own published
# sample key (AKIAIOSFODNN7EXAMPLE) and several "CHANGE-THIS" placeholders.
#
# Both patterns are SINGLE-quoted and contain no single quote of their own.
# The first version of this check embedded ["'] inline in a double-quoted
# string; the shell mangled it, grep read the tail of the pattern as a
# filename, printed "No such file or directory" -- and the hook passed anyway
# on a staged AKIA key. A gate that cannot fail is worse than no gate, so the
# value side matches an optional double quote only, and both directions are
# exercised before this is trusted.
SECRET_RE='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|ya29\.[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|gh[pousr]_[A-Za-z0-9]{30,}|(secret_access_key|account_key|access_key_id|client_secret|api_key|password|jwt_secret)[[:space:]]*[:=][[:space:]]*"?[A-Za-z0-9+/=_-]{32,}'
ALLOW_RE='EXAMPLE|CHANGE-THIS|CHANGE_THIS|your-|your_|replace-with|replace_with|placeholder|test-secret|dummy|fake|xxxx'
secret_hits=$(git diff --cached -U0 --diff-filter=ACM |
  grep -E '^\+' | grep -vE '^\+\+\+' |
  grep -EI "$SECRET_RE" |
  grep -viE "$ALLOW_RE")
if [ -n "$secret_hits" ]; then
  echo "❌ Possible credential in staged changes:"
  echo "$secret_hits" | sed 's/^/    /'
  echo "   Move it to a gitignored file (dev-tests/dev-server/, qa-suite/work/)"
  echo "   or use a {{TOKEN}} placeholder. Override: git commit --no-verify."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
